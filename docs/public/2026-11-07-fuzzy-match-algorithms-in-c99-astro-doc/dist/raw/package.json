{
  "name": "fuzzy-keys-reader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 0.0.0.0",
    "prepare:docs": "python3 scripts/prepare_starlight.py",
    "build": "npm run prepare:docs && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check:docs": "python3 scripts/check_starlight.py",
    "test:layout": "node scripts/check_layout.mjs"
  },
  "dependencies": {
    "astro": "7.4.7",
    "@astrojs/starlight": "0.42.10",
    "@astrojs/markdown-remark": "7.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
