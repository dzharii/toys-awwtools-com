---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
---
<div class="reader-header">
  <div class="reader-title"><SiteTitle /></div>
  <div class="reader-search"><Search /></div>
  <label class="text-size-control" for="reader-size">
    <span>Text size</span>
    <select id="reader-size" name="reader-size">
      <option value="standard">18 px</option>
      <option value="large">20 px</option>
      <option value="larger">22 px</option>
    </select>
  </label>
  <div class="reader-theme"><ThemeSelect /></div>
</div>
<script>
  import { initializeNavigation } from '../navigation';
  initializeNavigation();
  document.addEventListener('astro:page-load', initializeNavigation);
</script>
