---
import Sidebar from '@astrojs/starlight/components/Sidebar.astro';
---
<div class="navigation-tools" data-pagefind-ignore>
  <span class="navigation-label">Navigation</span>
  <button id="navigation-toggle" type="button" aria-expanded="true" aria-controls="reader-navigation">Hide</button>
</div>
<div id="reader-navigation"><Sidebar /></div>
<div id="navigation-resize" class="navigation-resize" role="separator" tabindex="0"
  aria-label="Navigation width" aria-orientation="vertical" aria-valuemin="200"
  aria-valuemax="420" aria-valuenow="272" aria-controls="starlight__sidebar"
  title="Drag to resize. Arrow keys change width; Home resets it."></div>
