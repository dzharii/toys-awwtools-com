{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sovet-rdtl.dearshrew7.chatgpt.site/data/schema/expression.schema.json",
  "title": "SovetRDTL expression schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "library",
    "canonical",
    "variants",
    "topics",
    "tones",
    "tier",
    "weight",
    "roles",
    "originId",
    "familyId"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(common|odessa)\\.[a-z0-9.-]+$"
    },
    "library": {
      "enum": [
        "common",
        "odessa"
      ]
    },
    "canonical": {
      "type": "string",
      "minLength": 1
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "tones": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ironic",
          "strict",
          "sarcastic"
        ]
      }
    },
    "tier": {
      "enum": [
        "core",
        "extended"
      ]
    },
    "weight": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "standalone",
          "opening",
          "closing"
        ]
      }
    },
    "originId": {
      "type": "string",
      "pattern": "^origin\\."
    },
    "familyId": {
      "type": "string",
      "minLength": 1
    },
    "irritation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "isTemplate": {
      "type": "boolean"
    },
    "scenarios": {
      "type": "array",
      "items": {
        "enum": [
          "normal",
          "opening",
          "closing",
          "audio",
          "image",
          "file"
        ]
      }
    },
    "category": {
      "enum": [
        "opening",
        "closing"
      ]
    },
    "forms": {
      "type": "object",
      "required": [
        "masculine",
        "feminine"
      ],
      "additionalProperties": false,
      "properties": {
        "masculine": {
          "type": "string",
          "minLength": 1
        },
        "feminine": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "closingContext": {
      "enum": [
        "departure",
        "bedtime"
      ]
    },
    "requiresTopics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contextPattern": {
      "type": "string"
    },
    "situations": {
      "type": "array",
      "items": {
        "enum": [
          "accomplished",
          "promise",
          "offer",
          "stance",
          "clarification",
          "initiative",
          "meta_parent",
          "news"
        ]
      }
    },
    "appendable": {
      "type": "boolean"
    },
    "repeatClosing": {
      "type": "boolean"
    },
    "pendingTopics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
