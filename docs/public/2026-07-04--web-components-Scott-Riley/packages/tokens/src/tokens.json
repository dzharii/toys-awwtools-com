{
  "meta": {
    "name": "My DS",
    "description": "A practical token set for a small framework-agnostic component library."
  },
  "global": {
    "color": {
      "neutral0": "#ffffff",
      "neutral50": "#f8fafc",
      "neutral100": "#eef2f7",
      "neutral200": "#d8e0ea",
      "neutral300": "#b8c4d4",
      "neutral500": "#64748b",
      "neutral700": "#334155",
      "neutral850": "#172033",
      "neutral900": "#0f172a",
      "blue500": "#2f6fed",
      "blue600": "#245bd1",
      "red100": "#fee2e2",
      "red300": "#fca5a5",
      "red700": "#b91c1c",
      "green100": "#dcfce7",
      "green300": "#86efac",
      "green800": "#166534",
      "amber100": "#fef3c7",
      "amber700": "#a16207"
    },
    "space": {
      "2xs": "0.25rem",
      "xs": "0.5rem",
      "sm": "0.75rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "2xl": "3rem"
    },
    "type": {
      "body": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "mono": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace",
      "sizeSm": "0.875rem",
      "sizeMd": "1rem",
      "sizeLg": "1.125rem",
      "sizeXl": "1.35rem",
      "lineNormal": "1.5",
      "lineTight": "1.2",
      "weightNormal": "400",
      "weightMedium": "550",
      "weightStrong": "700"
    },
    "radius": {
      "xs": "0.25rem",
      "sm": "0.375rem",
      "md": "0.5rem",
      "lg": "0.75rem",
      "pill": "999px"
    },
    "border": {
      "thin": "1px",
      "thick": "2px"
    },
    "motion": {
      "fast": "120ms",
      "normal": "180ms",
      "slow": "260ms"
    }
  },
  "themes": {
    "default": {
      "color": {
        "surfaceDefault": "{global.color.neutral0}",
        "surfaceSubtle": "{global.color.neutral50}",
        "surfaceRaised": "{global.color.neutral0}",
        "surfaceInverse": "{global.color.neutral900}",
        "borderQuiet": "{global.color.neutral200}",
        "borderLoud": "{global.color.neutral500}",
        "textLoud": "{global.color.neutral900}",
        "textDefault": "{global.color.neutral700}",
        "textQuiet": "{global.color.neutral500}",
        "focus": "{global.color.blue500}",
        "actionDefaultBg": "{global.color.neutral0}",
        "actionDefaultBgHover": "{global.color.neutral50}",
        "actionDefaultText": "{global.color.neutral900}",
        "actionPrimaryBg": "{global.color.blue500}",
        "actionPrimaryBgHover": "{global.color.blue600}",
        "actionPrimaryText": "#ffffff",
        "actionDangerBg": "{global.color.red100}",
        "actionDangerBgHover": "{global.color.red300}",
        "actionDangerText": "{global.color.red700}",
        "actionSuccessBg": "{global.color.green100}",
        "actionSuccessBgHover": "{global.color.green300}",
        "actionSuccessText": "{global.color.green800}",
        "statusWarningBg": "{global.color.amber100}",
        "statusWarningText": "{global.color.amber700}"
      }
    },
    "dark": {
      "color": {
        "surfaceDefault": "{global.color.neutral900}",
        "surfaceSubtle": "{global.color.neutral850}",
        "surfaceRaised": "#1e293b",
        "surfaceInverse": "{global.color.neutral0}",
        "borderQuiet": "#30405c",
        "borderLoud": "{global.color.neutral300}",
        "textLoud": "#f8fafc",
        "textDefault": "#d8e0ea",
        "textQuiet": "#b8c4d4",
        "focus": "#80a7ff",
        "actionDefaultBg": "#1e293b",
        "actionDefaultBgHover": "#27364d",
        "actionDefaultText": "#f8fafc",
        "actionPrimaryBg": "#80a7ff",
        "actionPrimaryBgHover": "#9bbaff",
        "actionPrimaryText": "#0f172a",
        "actionDangerBg": "#5f1717",
        "actionDangerBgHover": "#7f1d1d",
        "actionDangerText": "#fee2e2",
        "actionSuccessBg": "#14532d",
        "actionSuccessBgHover": "#166534",
        "actionSuccessText": "#dcfce7",
        "statusWarningBg": "#713f12",
        "statusWarningText": "#fef3c7"
      }
    },
    "highContrast": {
      "color": {
        "surfaceDefault": "#ffffff",
        "surfaceSubtle": "#f2f2f2",
        "surfaceRaised": "#ffffff",
        "surfaceInverse": "#000000",
        "borderQuiet": "#000000",
        "borderLoud": "#000000",
        "textLoud": "#000000",
        "textDefault": "#000000",
        "textQuiet": "#1f1f1f",
        "focus": "#0047ff",
        "actionDefaultBg": "#ffffff",
        "actionDefaultBgHover": "#f2f2f2",
        "actionDefaultText": "#000000",
        "actionPrimaryBg": "#000000",
        "actionPrimaryBgHover": "#1f1f1f",
        "actionPrimaryText": "#ffffff",
        "actionDangerBg": "#ffffff",
        "actionDangerBgHover": "#ffe5e5",
        "actionDangerText": "#8b0000",
        "actionSuccessBg": "#ffffff",
        "actionSuccessBgHover": "#e6ffe6",
        "actionSuccessText": "#005f20",
        "statusWarningBg": "#fff4c2",
        "statusWarningText": "#4d3400"
      }
    }
  },
  "semantic": {
    "space": {
      "actionX": "{global.space.md}",
      "actionY": "{global.space.sm}",
      "fieldGap": "{global.space.xs}",
      "cardPadding": "{global.space.lg}"
    },
    "type": {
      "bodyFamily": "{global.type.body}",
      "monoFamily": "{global.type.mono}",
      "controlSize": "{global.type.sizeMd}",
      "controlWeight": "{global.type.weightMedium}",
      "bodyLine": "{global.type.lineNormal}"
    },
    "radius": {
      "control": "{global.radius.md}",
      "surface": "{global.radius.lg}",
      "badge": "{global.radius.pill}"
    },
    "border": {
      "control": "{global.border.thin}",
      "focus": "{global.border.thick}"
    },
    "motion": {
      "interactive": "{global.motion.fast}",
      "disclosure": "{global.motion.normal}"
    }
  }
}
