      "declarations": [
        {
          "kind": "class",
          "declaration": {
            "name": "MyButton",
            "module": "./components/button.js"
          },
          "name": "MyButton",
          "tagName": "my-button",
          "customElement": true,
          "description": "A standard action component that renders either a semantic button or an anchor when `href` is provided.",
          "displayName": "Button",
          "status": "ready",
          "members": [
            {
              "kind": "field",
              "name": "variant",
              "type": {
                "text": "\"default\" | \"primary\" | \"danger\" | \"success\""
              },
              "default": "default",
              "description": "Visual intent of the action.",
              "attribute": "variant"
            },
            {
              "kind": "field",
              "name": "size",
              "type": {
                "text": "\"sm\" | \"md\" | \"lg\""
              },
              "default": "md",
              "description": "Control density and text size.",
              "attribute": "size"
            },
            {
              "kind": "field",
              "name": "href",
              "type": {
                "text": "string"
              },
              "default": "",
              "description": "When present, renders the component as a link.",
              "attribute": "href"
            },
            {
              "kind": "field",
              "name": "target",
              "type": {
                "text": "string"
              },
              "default": "",
              "description": "Anchor target used only when `href` is set.",
              "attribute": "target"
            },
            {
              "kind": "field",
              "name": "rel",
              "type": {
                "text": "string"
              },
              "default": "",
              "description": "Anchor relationship used only when `href` is set.",
              "attribute": "rel"
            },
            {
              "kind": "field",
              "name": "type",
              "type": {
                "text": "\"button\" | \"submit\" | \"reset\""
              },
              "default": "button",
              "description": "Native button type used when no `href` is set.",
              "attribute": "type"
            },
            {
              "kind": "field",
              "name": "disabled",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "description": "Prevents interaction for temporarily unavailable actions.",
              "attribute": "disabled"
            },
            {
              "kind": "field",
              "name": "loading",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "description": "Shows a busy state and prevents repeated activation.",
              "attribute": "loading"
            },
            {
              "kind": "field",
              "name": "icon",
              "type": {
                "text": "\"check\" | \"close\" | \"info\" | \"warning\" | \"arrow-right\" | \"\""
              },
              "default": "",
              "description": "Optional leading icon name.",
              "attribute": "icon"
