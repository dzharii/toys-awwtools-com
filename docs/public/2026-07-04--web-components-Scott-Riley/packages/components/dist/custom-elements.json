            {
              "kind": "field",
              "name": "aria-label",
              "type": {
                "text": "string"
              },
              "default": "",
              "description": "Accessible label used when the visible label is not enough, especially for icon-only buttons.",
              "attribute": "aria-label"
            }
          ]
