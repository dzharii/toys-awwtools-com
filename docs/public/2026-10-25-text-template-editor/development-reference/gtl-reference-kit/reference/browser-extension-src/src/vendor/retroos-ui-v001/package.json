{
  "name": "awwbookmarklet-ui-framework",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "bun run ./scripts/build.mts --mode development",
    "build:prod": "bun run ./scripts/build.mts --mode production",
    "dev": "bun run ./scripts/build.mts --watch --mode development",
    "validate:icons": "bun run ./scripts/render-icons.mts",
    "test": "bun run test:all",
    "test:all": "bun run test:unit && bun run test:dom",
    "test:unit": "bun test ./test/*.test.ts",
    "test:dom": "bun test ./test/dom/dom-*.dom.test.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
