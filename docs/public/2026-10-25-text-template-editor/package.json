{
  "name": "guided-document-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run typecheck && bun scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tools.json",
    "dev": "bun run build && bun scripts/serve.ts",
    "preview": "bun scripts/serve.ts",
    "test:browser": "bun run --cwd ui-regression-test-suite test:all",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check && bun test && bun run build && bun run test:browser"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
