{
  "name": "guided-ui-regression-test-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "bun scripts/check-boundaries.ts && bun scripts/check-surface-registry.ts && bun ./node_modules/typescript/bin/tsc --noEmit",
    "test:unit": "bun test src/specs/unit",
    "test:smoke": "playwright test --project smoke",
    "test:acceptance": "playwright test --project acceptance",
    "test:all": "bun run typecheck && bun run test:unit && playwright test --project smoke --project acceptance",
    "test:capture": "playwright test --project capture",
    "test:headed": "playwright test --project acceptance --headed",
    "test:debug": "playwright test --project acceptance --debug",
    "test:sensitivity": "bun scripts/verify-sensitivity.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.58.2",
    "@types/bun": "1.3.9",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-compiler-api": "npm:typescript@6.0.3"
  }
}
